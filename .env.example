NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/zaylo

# Redis (host/port preferred; REDIS_URL is optional/legacy)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379

# Logging
LOG_LEVEL=debug

# CORS — Frontend / Admin origins (comma-separated for multiple)
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Auth (used when JWT middleware is added)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Object storage — "r2" (Cloudflare) or "s3" (AWS). Prefer r2 + presigned PUT.
STORAGE_PROVIDER=r2
STORAGE_SIGNED_URL_EXPIRES=3600
STORAGE_PRESIGN_EXPIRES=300
STORAGE_MAX_FILE_SIZE_MB=5

# Image → WebP (sharp). Used by legacy multipart proxy upload only.
STORAGE_WEBP_ENABLED=true
STORAGE_WEBP_BACKGROUND=true
STORAGE_WEBP_QUALITY=80
STORAGE_WEBP_MAX_WIDTH=1920

# Cloudflare R2 (when STORAGE_PROVIDER=r2)
# Public access: custom domain (preferred) or *.r2.dev → set as R2_PUBLIC_URL
# API token: Object Read & Write on this bucket only
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.example.com

# AWS S3 (when STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# Customer auth (website): short access token + rotating httpOnly refresh cookie.
# Admin panel keeps JWT_EXPIRES_IN tokens (unchanged flow).
CUSTOMER_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# COOKIE_SECURE=true          # defaults to true in production
# COOKIE_SAMESITE=none        # 'none' in production (cross-site API), 'lax' in dev

# Payments — Razorpay. Stays DISABLED unless PAYMENTS_ENABLED=true AND all three keys are set.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed script admin/manager passwords (required to run `npm run seed`)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=

# Seed staff emails (optional; default admin@zaylo.com / manager@zaylo.com)
SEED_ADMIN_EMAIL=
SEED_MANAGER_EMAIL=
